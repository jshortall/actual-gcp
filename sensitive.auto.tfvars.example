# Copy to sensitive.auto.tfvars (gitignored) and fill in.
actual_fqdn              = "budget.example.com"
gcp_project_name         = "my-actual-project"
gcp_billing_project_name = "my-actual-project"
billing_account_name     = "My Billing Account" # gcloud billing accounts list
gcp_region               = "us-central1"
gcp_zone                 = "us-central1-c"
user                     = "your_google_username"

# Google sign-in: Google Auth Platform -> Clients -> Web application,
# authorized redirect URI https://budget.example.com/openid/callback
google_oauth_client_id     = "....apps.googleusercontent.com"
google_oauth_client_secret = "GOCSPX-..."
